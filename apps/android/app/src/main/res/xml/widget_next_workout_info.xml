<?xml version="1.0" encoding="utf-8"?>
<!--
    minWidth/minHeight size the widget on launchers before Android 12, targetCell* on newer ones.
    No update period: the app pushes every change itself.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_next_workout_description"
    android:initialLayout="@layout/widget_next_workout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="80dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_next_workout_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
