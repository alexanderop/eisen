<?xml version="1.0" encoding="utf-8"?>
<!--
  The lifter's data is one file. It goes into the phone's Google backup
  and onto a new phone when the old one is copied over. A running rest timer does not.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="eisen.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="eisen.json" />
    </device-transfer>
</data-extraction-rules>
