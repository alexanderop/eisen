<?xml version="1.0" encoding="utf-8"?>
<!-- One exercise of the widget, like a row of the home screen's "Next up" card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/widget_row_height"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_row_sets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_row_weight"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
