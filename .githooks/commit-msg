#!/bin/bash
# The commit gate. Mode: git config eisen.gate off|observe|enforce (default observe).
# A commit stamped "Verified: none" passes when its message says why: a trailer "Unverified: <reason>".
# observe logs what enforce would have blocked; enforce blocks, at most twice in a row.
set -u
. "$(git rev-parse --show-toplevel)/.githooks/lib.sh"
mode="$(git config --get eisen.gate || echo observe)"
[ "$mode" = off ] && exit 0
grep -q '^Verified: none$' "$1" || { /bin/rm -f "$(eisen_dir)/blocked"; exit 0; }
grep -qE '^Unverified: .+' "$1" && exit 0
dir="$(eisen_dir)"; subject="$(grep -v '^#' "$1" | head -1)"
if [ "$mode" = observe ]; then
  echo "$(date +%Y-%m-%dT%H:%M:%S) would block: $subject" >> "$dir/gate.log"
  echo "gate (observe): this commit is not verified. Run bin/check or the verify-eisen skill, or add 'Unverified: <reason>'." >&2
  exit 0
fi
blocked="$(cat "$dir/blocked" 2>/dev/null || echo 0)"
if [ "$blocked" -ge 2 ]; then
  echo "$(date +%Y-%m-%dT%H:%M:%S) let through after two blocks: $subject" >> "$dir/gate.log"
  /bin/rm -f "$dir/blocked"; exit 0
fi
echo $((blocked + 1)) > "$dir/blocked"
echo "$(date +%Y-%m-%dT%H:%M:%S) blocked: $subject" >> "$dir/gate.log"
echo "gate: not verified. Run bin/check or the verify-eisen skill and commit again, or add a trailer 'Unverified: <reason>'." >&2
exit 1
