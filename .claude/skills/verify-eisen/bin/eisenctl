#!/bin/bash
# Drives the Eisen Android app on the emulator for verification. See ../SKILL.md.
# Every command reads its stdin from /dev/null, so it never waits for input.
set -u
exec < /dev/null

SDK="${ANDROID_HOME:-/opt/homebrew/share/android-commandlinetools}"
ADB="$SDK/platform-tools/adb"
EMULATOR="$SDK/emulator/emulator"
export JAVA_HOME="${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}"
export ANDROID_HOME="$SDK"
PKG=io.github.alexanderop.eisen
# Two emulators with the same screen can run at once (`journeys`): EISEN_AVD says which one this command
# drives. Each has its port, so its serial is known before it runs, and every adb call below goes to it.
AVDS="eisen eisen361"
AVD="${EISEN_AVD:-eisen}"
case "$AVD" in eisen) PORT=5554; OWN="";; eisen361) PORT=5556; OWN="-$AVD";; *) echo "eisenctl: no AVD '$AVD' here, there are: $AVDS" >&2; exit 1;; esac
export ANDROID_SERIAL="emulator-$PORT"
ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
APK="$ROOT/apps/android/app/build/outputs/apk/debug/app-debug.apk"
BASE="$ROOT/verify/android"
STATE="$BASE/.state$OWN"
FILES="eisen.json timer-run.json wod-draft.json plate.json"
FIXTURES="$ROOT/.claude/skills/verify-eisen/fixtures"

TAB="$(printf '\t')"
die() { echo "eisenctl: $*" >&2; exit 1; }
device() { "$ADB" devices | awk -v s="$ANDROID_SERIAL" 'NR>1 && $1==s && $2=="device" {print $1; exit}'; }
booted() { [ "$("$ADB" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ]; }
run_dir() { [ -f "$STATE/run" ] || die "no run: start one with 'eisenctl launch'"; cat "$STATE/run"; }
# Reading the screen takes two seconds, and it was most of a journey's time: a line such as
# `wait A && has B && visible C && tap D` read the same screen four times. So the last read is kept
# and used again while it can still be true: nothing was sent to the phone since (`touched` forgets it)
# and it is at most $KEEP seconds old. A check that fails on a kept read is made again on a fresh one
# (`on_screen`), so a kept read never fails a check; `gone`, `texts` and a waiting `wait` always read.
KEEP=2
SCREEN="$STATE/screen.xml"
touched() { /bin/rm -f "$SCREEN"; }
kept() { [ -s "$SCREEN" ] && [ $(( $(date +%s) - $(stat -f %m "$SCREEN") )) -le "$KEEP" ]; }
fresh() {
  mkdir -p "$STATE"
  "$ADB" exec-out uiautomator dump /dev/tty 2>/dev/null > "$SCREEN.$$"
  if grep -q '<node' "$SCREEN.$$"; then mv "$SCREEN.$$" "$SCREEN"; cat "$SCREEN"; else cat "$SCREEN.$$"; /bin/rm -f "$SCREEN.$$" "$SCREEN"; fi
}
dump() { if kept; then cat "$SCREEN"; else fresh; fi; }
# Runs "$@", a check that reads the screen: on the kept read first, and when that fails, on a fresh one.
on_screen() { if kept; then "$@" 2>/dev/null && return 0; touched; fi; "$@"; }
# One line per node that has a text or a description: "kind=value<TAB>[x1,y1][x2,y2]".
# The tab ends the value, so "Timer" does not match "Timer voice".
nodes() {
  dump | tr '>' '>\n' | grep -oE '(text|content-desc)="[^"]+"[^>]*bounds="\[[0-9]+,[0-9]+\]\[[0-9]+,[0-9]+\]"' \
    | sed -E 's/^(text|content-desc)="([^"]+)".*bounds="(.*)"$/\1=\2'"$TAB"'\3/'
}
fixtures() { /bin/ls "$FIXTURES" 2>/dev/null | sed -n 's/\.json$//p' | tr '\n' ' '; }
file_of() { "$ADB" shell "run-as $PKG cat files/$1" 2>/dev/null; }
# Pixels per dp of the emulator's screen.
density() { "$ADB" shell wm density | tail -1 | grep -oE '[0-9]+$'; }
screen_size() { "$ADB" shell wm size | tail -1 | grep -oE '[0-9]+x[0-9]+$' | tr x ' '; }
# Every node of one dump as "kind=value<TAB>bounds<TAB>bounds of the node a tap on it reaches (itself or the
# nearest clickable around it, "-" for none)<TAB>"cut" when that node touches the edge of the list it scrolls in,
# where the list may cut it off (its bounds are then only the part on screen)". A clickable node without a text or
# a description is listed as "clickable=".
tree() {
  dump | perl -ne '
    sub edge { my ($b, $s) = @_; return "" unless defined $b && defined $s;
      my @b = $b =~ /(\d+)/g; my @s = $s =~ /(\d+)/g; return ($b[1] <= $s[1] || $b[3] >= $s[3]) ? "cut" : ""; }
    while (/<node ([^>]*?)(\/?)>|<\/node>/g) {
      if (!defined $1) { pop @stack; next; }
      my ($attrs, $closed) = ($1, $2);
      my %a; $a{$1} = $2 while $attrs =~ /([\w-]+)="([^"]*)"/g;
      my ($up, $scroll, $upcut) = @stack ? @{$stack[-1]} : (undef, undef, "");
      my $click = ($a{clickable} eq "true" || $a{"long-clickable"} eq "true" || $a{checkable} eq "true") ? $a{bounds} : undef;
      my $reach = $click // $up;
      my $cut = $click ? edge($click, $scroll) : $upcut;
      for my $kind ("text", "content-desc") {
        print "$kind=$a{$kind}\t$a{bounds}\t", ($reach // "-"), "\t$cut\n" if $a{$kind} ne "";
      }
      print "clickable=\t$a{bounds}\t$a{bounds}\t$cut\n" if $click && $a{text} eq "" && $a{"content-desc"} eq "";
      push @stack, [$reach, ($a{scrollable} eq "true" ? $a{bounds} : $scroll), $cut] unless $closed;
    }'
}
# "x1 y1 x2 y2" of "[x1,y1][x2,y2]".
corners() { echo "$1" | grep -oE '[0-9]+' | tr '\n' ' '; }
# Two finger-like taps at x y, [gap] ms from the lift of the first to the press of the second.
# One adb shell for both: a second one alone takes longer than the gap. `input motionevent` takes about
# 11 ms, so the sleep is that much shorter.
taps() {
  local x=$1 y=$2 gap=$3 pause
  pause="$(awk -v g="$gap" 'BEGIN { s = (g - 11) / 1000; if (s < 0) s = 0; printf "%.3f", s }')"
  "$ADB" shell "input motionevent DOWN $x $y; sleep 0.04; input motionevent MOVE $((x + 2)) $((y + 1)); input motionevent UP $((x + 2)) $((y + 1)); sleep $pause; input motionevent DOWN $x $y; sleep 0.04; input motionevent MOVE $((x + 1)) $((y + 2)); input motionevent UP $((x + 1)) $((y + 2))"
}

case "${1:-}" in
  launch)
    shift; fresh=0; build=1; fixture=""; animations=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --fresh) fresh=1;;
        --no-build) build=0;;
        # The animation scales stay at 1, as on a phone: taps during a transition, screens mid-exit.
        --animations) animations=1;;
        # A prepared eisen.json: fresh app data, then this file, then the app starts on it.
        --state)
          [ -n "${2:-}" ] || die "--state <name>, one of: $(fixtures)"
          fixture="$FIXTURES/$2.json"; fresh=1; shift
          [ -f "$fixture" ] || die "no fixture '$(basename "$fixture" .json)', there are: $(fixtures)"
          ;;
        *) die "unknown option $1";;
      esac
      shift
    done
    mkdir -p "$STATE"; touched
    [ -f "$STATE/run" ] && die "a run is open ($(cat "$STATE/run")): finish it with 'eisenctl cleanup' first"
    if [ -z "$(device)" ]; then
      "$EMULATOR" -list-avds | grep -qx "$AVD" || die "no AVD named $AVD (emulator -list-avds)"
      nohup "$EMULATOR" -avd "$AVD" -port "$PORT" -no-audio -no-snapshot-save -no-boot-anim > "$STATE/emulator.log" 2>&1 &
      echo $! > "$STATE/emulator.pid"
      "$ADB" wait-for-device
    fi
    for _ in $(seq 120); do booted && break; sleep 2; done
    booted || die "the emulator did not finish booting"
    if [ "$build" = 1 ]; then
      (cd "$ROOT/apps/android" && ./gradlew assembleDebug -q) || die "the debug build failed"
      # The sources this APK was built from: cleanup stamps them as verified on the emulator.
      (cd "$ROOT" && . .githooks/lib.sh && eisen_source_hash) > "$STATE/hash"
      # A journey stamps the sources only when every APK it ran was built from them.
      [ -n "${EISEN_JOURNEY:-}" ] && cat "$STATE/hash" >> "$EISEN_JOURNEY"
    fi
    [ -f "$APK" ] || die "no APK at $APK"
    run="$BASE/$(date +%Y%m%d-%H%M%S)$OWN"; mkdir -p "$run"; echo "$run" > "$STATE/run"
    # What the emulator's app held before this run comes back in cleanup.
    if "$ADB" shell pm list packages | grep -q "package:$PKG\$"; then
      "$ADB" shell am force-stop $PKG
      mkdir -p "$STATE/backup"
      for name in $FILES; do file_of "$name" > "$STATE/backup/$name"; [ -s "$STATE/backup/$name" ] || rm -f "$STATE/backup/$name"; done
    fi
    "$ADB" install -r "$APK" > "$run/install.log" 2>&1 || die "install failed, see $run/install.log"
    if [ "$fresh" = 1 ]; then "$ADB" shell pm clear $PKG > /dev/null; fi
    if [ -n "$fixture" ]; then
      # Moved by whole weeks so its newest entry is in the last seven days: "this week" and the
      # last 12 weeks of Progress keep something to show, on the same weekdays, however old the file.
      # The food log moves by whole weeks too, its newest day into the seven days before today (the
      # phone's today), so today starts empty and the times of day stay what they were. The weights
      # (and a check-in answered) move with it, by the same days.
      shifted="$run/00-fixture-$(basename "$fixture")"
      today="$("$ADB" shell date +%Y-%m-%d | tr -d '\r')"
      jq -c --argjson now "$(date +%s)000" --arg today "$today" '
        ([.. | objects | (.startedAt?, .finishedAt?) | numbers] | max // $now) as $newest
        | ((($now - $newest) / 604800000 | floor) * 604800000) as $by
        | walk(if type == "object" then with_entries(if (.key == "startedAt" or .key == "finishedAt") and (.value | type) == "number" then .value += $by else . end) else . end)
        | ([.foodLog[]?.day] | max) as $last
        | (if $last == null then 0 else (((($today | strptime("%Y-%m-%d") | mktime) - ($last | strptime("%Y-%m-%d") | mktime)) / 86400 | floor) as $d | 7 * ((($d - 1) / 7) | floor)) end) as $days
        | def moved: (strptime("%Y-%m-%d") | mktime) + $days * 86400 | strftime("%Y-%m-%d");
        if has("foodLog") then .foodLog |= map(.at += $days * 86400000 | .day |= moved) else . end
        | if has("weights") then .weights |= map(.at += $days * 86400000 | .day |= moved) else . end
        | if .weightGoal.checkIn? then .weightGoal.checkIn.week |= moved else . end
      ' "$fixture" > "$shifted" || die "could not read $fixture"
      "$ADB" shell "run-as $PKG mkdir -p files" && "$ADB" shell "run-as $PKG sh -c 'cat > files/eisen.json'" < "$shifted" \
        || die "could not write $fixture into the app"
    fi
    "$ADB" shell pm grant $PKG android.permission.POST_NOTIFICATIONS 2>/dev/null
    # What `font` changes, `cleanup` puts back.
    "$ADB" shell settings get system font_scale | tr -d '\r' > "$STATE/font_scale"
    for scale in window_animation_scale transition_animation_scale animator_duration_scale; do "$ADB" shell settings put global $scale $animations; done
    "$ADB" shell cmd audio set-volume 3 0 > /dev/null 2>&1
    # A screen left off (by a journey that stopped half-way) shows uiautomator nothing.
    "$ADB" shell input keyevent KEYCODE_WAKEUP
    "$ADB" shell wm dismiss-keyguard
    "$ADB" logcat -c
    # The phone's clock at the start: `buzzed` only looks at vibrations after it.
    "$ADB" shell date +%m-%d_%H:%M:%S.000 | tr -d '\r' | tr _ ' ' > "$STATE/started"
    "$ADB" shell am start -n $PKG/.MainActivity > /dev/null
    # Ready is the app's first screen with its texts: the five tabs, or a workout or timer that runs.
    shown() { fresh | grep -qE "text=\"[^\"]+\"[^>]* package=\"$PKG\""; }
    deadline=$(( $(date +%s) + 30 ))
    until shown || [ "$(date +%s)" -ge "$deadline" ]; do :; done
    shown || die "the app did not show its first screen within 30s, see 'eisenctl texts'"
    echo "ready: $run"
    ;;
  doctor)
    ok=0
    check() { if eval "$2"; then echo "ok    $1"; else echo "FAIL  $1"; ok=1; fi; }
    check "one emulator is attached" '[ -n "$(device)" ]'
    check "it is the AVD $AVD" '[ "$("$ADB" shell getprop ro.boot.qemu.avd_name | tr -d "\r")" = "$AVD" ]'
    check "it has booted" 'booted'
    check "a run is open (eisenctl launch)" '[ -f "$STATE/run" ] && [ -d "$(cat "$STATE/run")" ]'
    check "the app is installed" '"$ADB" shell pm list packages | grep -q "package:$PKG\$"'
    installed="$("$ADB" shell "sha256sum \$(pm path $PKG | head -1 | cut -d: -f2)" 2>/dev/null | cut -d" " -f1)"
    check "the installed APK is the one built here" '[ -f "$APK" ] && [ "$installed" = "$(shasum -a 256 "$APK" | cut -d" " -f1)" ]'
    check "the app is on screen" '"$ADB" shell dumpsys activity activities | grep -E "ResumedActivity|topResumedActivity" | grep -q "$PKG"'
    check "media volume is 0 (test muted)" '"$ADB" shell dumpsys audio | grep -A1 "^- STREAM_MUSIC:" | grep -q "Muted: true"'
    check "no crash since launch" '! "$ADB" logcat -d | grep -q "FATAL EXCEPTION"'
    exit $ok
    ;;
  texts) touched; nodes ;;
  has)
    # Several handles are checked on one read of the screen.
    shift; [ $# -gt 0 ] || die "has <regex>..."
    has_all() {
      local screen handle; screen="$(nodes)"
      for handle in "$@"; do echo "$screen" | grep -qE "^(text|content-desc)=($handle)$TAB" || { echo "eisenctl: '$handle' is not on screen" >&2; return 1; }; done
    }
    on_screen has_all "$@" || exit 1
    ;;
  gone)
    # None of the handles is on screen, on a fresh read: a kept one could still show what has left since.
    # (`! eisenctl has` would pass on a kept read; a journey refuses it.)
    shift; [ $# -gt 0 ] || die "gone <regex>..."
    touched; screen="$(nodes)"
    [ -n "$screen" ] || die "the screen could not be read"
    for handle in "$@"; do echo "$screen" | grep -qE "^(text|content-desc)=($handle)$TAB" && { echo "eisenctl: '$handle' is on screen" >&2; exit 1; }; done
    exit 0
    ;;
  wait)
    # By the clock: a read takes about two seconds, so counting tries would wait three times as long.
    # The kept read answers at once when it has the handle; after that every try reads.
    deadline=$(( $(date +%s) + ${3:-15} ))
    while :; do
      nodes | grep -qE "^(text|content-desc)=($2)$TAB" && exit 0
      touched
      [ "$(date +%s)" -lt "$deadline" ] || break
    done
    die "'$2' did not appear within ${3:-15}s"
    ;;
  tap|hold)
    find_line() { local line; line="$(nodes | grep -E "^(text|content-desc)=($1)$TAB" | sed -n "${2:-1}p")"; [ -n "$line" ] && echo "$line"; }
    line="$(on_screen find_line "$2" "${3:-1}")"
    [ -n "$line" ] || die "nothing on screen matches '$2' (see 'eisenctl texts')"
    action="$1"; set -- $(echo "$line" | grep -oE '\[[0-9]+,[0-9]+\]\[[0-9]+,[0-9]+\]$' | grep -oE '[0-9]+')
    x=$(( ($1 + $3) / 2 )); y=$(( ($2 + $4) / 2 ))
    # A hold is a swipe that does not move: a press of one second ("Hold to finish" fills in 0.7 s).
    # A tap moves two pixels on its way, as a finger does: `input tap` sends a down and an up with
    # nothing between, and a tap that only works without a move does not work on a phone.
    if [ "$action" = hold ]; then "$ADB" shell input swipe $x $y $x $y 1000; else "$ADB" shell input swipe $x $y $((x + 2)) $((y + 1)) 60; fi
    touched
    sleep 0.6
    ;;
  doubletap)
    # Two taps on one place from one dump, [gap] ms apart (default 150): a bounce of a sweaty thumb.
    [ -n "${2:-}" ] || die "doubletap <regex> [n] [gap-ms]"
    find_line() { local line; line="$(nodes | grep -E "^(text|content-desc)=($1)$TAB" | sed -n "${2:-1}p")"; [ -n "$line" ] && echo "$line"; }
    line="$(on_screen find_line "$2" "${3:-1}")"
    [ -n "$line" ] || die "nothing on screen matches '$2' (see 'eisenctl texts')"
    set -- "${4:-150}" $(corners "${line##*$TAB}")
    taps $(( ($2 + $4) / 2 )) $(( ($3 + $5) / 2 )) "$1"
    touched
    sleep 0.6
    ;;
  font)
    # The system font scale (1.0 is the default); `cleanup` puts back the one the run found.
    [ -n "${2:-}" ] || die "font <scale>, such as 1.3 or 2.0"
    run_dir > /dev/null
    "$ADB" shell settings put system font_scale "$2"
    touched
    # The app redraws with the new scale; give it the moment it needs.
    sleep 1.5
    ;;
  visible)
    # Each handle on screen in one dump: its bounds not empty and inside the screen, and what a tap on
    # it reaches (itself or the clickable around it) at least 48 dp each way.
    shift; [ $# -gt 0 ] || die "visible <regex>..."
    visible_all() {
      local screen dp width height min bad handle line x1 y1 x2 y2 reach
      screen="$(tree)"; dp="$(density)"; read -r width height <<< "$(screen_size)"; min=$(( 48 * dp / 160 - 1 ))
      bad=0
      for handle in "$@"; do
        line="$(echo "$screen" | grep -E "^(text|content-desc)=($handle)$TAB" | head -1)"
        if [ -z "$line" ]; then echo "eisenctl: '$handle' is not on screen" >&2; bad=1; continue; fi
        read -r x1 y1 x2 y2 <<< "$(corners "$(echo "$line" | cut -f2)")"
        if [ "$x2" -le "$x1" ] || [ "$y2" -le "$y1" ] || [ "$x1" -lt 0 ] || [ "$y1" -lt 0 ] || [ "$x2" -gt "$width" ] || [ "$y2" -gt "$height" ]; then
          echo "eisenctl: '$handle' is cut off or empty at $(echo "$line" | cut -f2)" >&2; bad=1; continue
        fi
        reach="$(echo "$line" | cut -f3)"
        if [ "$(echo "$line" | cut -f4)" = cut ]; then echo "eisenctl: '$handle' is at the edge of its list, which may cut it off: scroll first" >&2; bad=1; continue; fi
        [ "$reach" = - ] && continue
        read -r x1 y1 x2 y2 <<< "$(corners "$reach")"
        if [ $(( x2 - x1 )) -lt "$min" ] || [ $(( y2 - y1 )) -lt "$min" ]; then
          echo "eisenctl: '$handle' is tapped on $(( (x2 - x1) * 160 / dp ))×$(( (y2 - y1) * 160 / dp )) dp, under 48 dp" >&2; bad=1
        fi
      done
      return $bad
    }
    on_screen visible_all "$@" || exit 1
    ;;
  small)
    # Every clickable node of the app on screen under 48 dp either way, with its label. Fails when there is one.
    small_ones() {
    local screen dp min; screen="$(tree)"; dp="$(density)"; min=$(( 48 * dp / 160 - 1 ))
    # A clickable node without a label of its own is named by the first text or description in it.
    echo "$screen" | awk -F"$TAB" -v min="$min" -v dp="$dp" '
      $3 != "-" && $4 != "cut" {
        if (!($3 in label)) { order[++n] = $3; label[$3] = "" }
        if (label[$3] == "" && $1 != "clickable=") label[$3] = $1
      }
      END {
        for (i = 1; i <= n; i++) {
          split(order[i], c, /[^0-9]+/); w = c[4] - c[2]; h = c[5] - c[3]
          if (w > 0 && h > 0 && (w < min || h < min)) printf "%d×%d dp  %s  %s\n", w * 160 / dp, h * 160 / dp, order[i], (label[order[i]] == "" ? "(no label)" : label[order[i]])
        }
      }'
    }
    # Something small on a kept read is looked at again on a fresh one before it counts.
    was_kept=0; kept && was_kept=1
    found="$(small_ones)"
    if [ -n "$found" ] && [ "$was_kept" = 1 ]; then touched; found="$(small_ones)"; fi
    [ -z "$found" ] && exit 0
    echo "$found"; exit 1
    ;;
  buzzed)
    # The witness of a vibration nobody feels on an emulator: one of the app's, other than a touch
    # haptic, played since launch, and none was ignored (a vibration from the background without the
    # right usage is dropped by Android and logged "ignored_background").
    started="$(cat "$STATE/started" 2>/dev/null)" || die "no run: start one with 'eisenctl launch'"
    run="$(run_dir)"
    "$ADB" shell dumpsys vibrator_manager > "$run/vibrations.txt"
    since="$(grep " $PKG " "$run/vibrations.txt" | grep -v "usage: TOUCH" | awk -v s="$started" '($1 " " $2) >= s' | sort -u)"
    ignored="$(echo "$since" | grep "| *ignored")"
    [ -z "$ignored" ] || die "ignored since launch:
$(echo "$ignored" | cut -c1-160)"
    echo "$since" | grep -qE "\| *(finished|cancelled[a-z_]*|running) *\|" || die "no vibration played since launch (see $run/vibrations.txt)"
    echo "$since" | cut -c1-160
    ;;
  journey)
    # Runs a feature file's recipes from its first command to its last, stopping at the first command
    # that fails, also one in the middle of `a && b && c`. Only a journey whose every recipe passed on an
    # APK built from these sources stamps them "Verified: emulator".
    [ -n "${2:-}" ] || die "journey <feature> [recipe], features: $(/bin/ls "$ROOT/.claude/skills/verify-eisen/features" | sed -n 's/\.md$//p' | grep -v README | tr '\n' ' ')"
    file="$ROOT/.claude/skills/verify-eisen/features/$2.md"
    [ -f "$file" ] || die "no feature file $file"
    work="$BASE/.journey$OWN"; mkdir -p "$work"; /bin/rm -f "$work"/*
    # One script per recipe: from a line that launches to the line that cleans up, the sh blocks in order.
    # Each command of a line (split at a top-level && or ;) is checked on its own.
    perl -e '
      my ($file, $work) = @ARGV;
      open my $in, "<", $file or die "cannot read $file";
      my ($block, $n, $name, @names, $out) = (0, 0, "", ());
      sub split_line {
        my ($line) = @_; my @parts; my $cur = ""; my @stack; my @c = split //, $line;
        # @stack: what the character is inside of, the innermost last: a double quote, or ( { [[ of code.
        for (my $i = 0; $i < @c; $i++) {
          my $ch = $c[$i]; my $next = $i + 1 < @c ? $c[$i + 1] : "";
          if ($ch eq "\\") { $cur .= $ch . $next; $i++; next; }
          if (@stack && $stack[-1] eq "\"") {
            if ($ch eq "\"") { pop @stack; }
            elsif ($ch eq "\$" && $next eq "(") { push @stack, "("; $cur .= "\$("; $i++; next; }
            $cur .= $ch; next;
          }
          # A loop or a condition is one command up to its done, fi or esac.
          my $rest = substr($line, $i); my $before = $i == 0 ? "" : $c[$i - 1];
          if ($cur =~ /^\s*$/ && $rest =~ /^(for|while|until|if|case)\b/) { push @stack, "kw"; $cur .= $1; $i += length($1) - 1; next; }
          if (@stack && $stack[-1] eq "kw" && $before =~ /[\s;]/ && $rest =~ /^(done|fi|esac)\b/) { pop @stack; $cur .= $1; $i += length($1) - 1; next; }
          if ($ch eq "\x27") { my $end = index($line, "\x27", $i + 1); $end = $#c if $end < 0; $cur .= substr($line, $i, $end - $i + 1); $i = $end; next; }
          if ($ch eq "\"") { push @stack, "\""; }
          elsif ($ch eq "(" || $ch eq "{") { push @stack, $ch; }
          elsif ($ch eq "[" && $next eq "[") { push @stack, "[["; $cur .= "[["; $i++; next; }
          elsif (($ch eq ")" || $ch eq "}") && @stack) { pop @stack; }
          elsif ($ch eq "]" && $next eq "]" && @stack) { pop @stack; $cur .= "]]"; $i++; next; }
          elsif (!@stack && (($ch eq "&" && $next eq "&") || $ch eq ";")) { push @parts, $cur; $cur = ""; $i++ if $ch eq "&"; next; }
          $cur .= $ch;
        }
        push @parts, $cur;
        return grep { /\S/ } map { s/^\s+|\s+$//gr } @parts;
      }
      while (my $line = <$in>) {
        chomp $line;
        if ($line =~ /^```sh/) { $block = 1; next; }
        if ($line =~ /^```/) { $block = 0; next; }
        if (!$block) { @names = () if $line =~ /^## /; push @names, $1 while $line =~ /\*\*([^*]+)\*\*/g; next; }
        next if $line =~ /^\s*(#|$)/;
        die "$file: `! eisenctl has` passes on a kept read of the screen; write `eisenctl gone <regex>`:\n  $line\n" if $line =~ /!\s*eisenctl\s+has\b/;
        if (!$out && $line =~ /^eisenctl launch/) {
          $n++; open $out, ">", "$work/$n.sh";
          print $out "# recipe $n\n";
        }
        next unless $out;
        my @parts = $line =~ /^\s*(for|while|if|until|case)\b/ ? ($line) : split_line($line);
        for my $part (@parts) {
          print $out "$part\n";
          my $shown = $part =~ s/\x27/\x27\\\x27\x27/gr;
          print $out "__s=\$?; [ \"\$__s\" = 0 ] || __fail \"\$__s\" \x27$shown\x27\n";
        }
        if ($line =~ /eisenctl cleanup/) {
          print $out "# names: @names\n"; close $out; undef $out; open my $names, ">", "$work/$n.names"; print $names join(" / ", @names); close $names; @names = ();
        }
      }
      die "the last recipe of $file does not end with eisenctl cleanup\n" if $out;
    ' "$file" "$work" || die "could not read the recipes of $file"
    recipes="$(/bin/ls "$work" | sed -n 's/\.sh$//p' | sort -n)"
    [ -n "$recipes" ] || die "no recipe (a sh block that starts with 'eisenctl launch') in $file"
    if [ -n "${3:-}" ]; then
      chosen=""
      for r in $recipes; do { [ "$r" = "$3" ] || grep -qiE -- "$3" "$work/$r.names"; } && chosen="$chosen $r"; done
      [ -n "$chosen" ] || die "no recipe '$3' in $2; there are: $(for r in $recipes; do printf '%s (%s) ' "$r" "$(cat "$work/$r.names")"; done)"
      recipes="$chosen"
    fi
    export EISEN_JOURNEY="$work/hashes"; : > "$EISEN_JOURNEY"
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    for r in $recipes; do
      start=$(date +%s)
      echo "journey $2: recipe $r ($(cat "$work/$r.names")) ..."
      (
        cd "$ROOT" || exit 1
        # No pipefail: "dumpsys ... | grep -q" ends the pipe early on a match, and the producer's SIGPIPE
        # would fail a check that passed. A pipe's status is its last command, the check.
        exec bash -c '
          eisenctl() { "'"$self"'" "$@"; }
          __fail() { echo "journey: failed (exit $1): $2" >&2; "'"$self"'" doctor >&2; "'"$self"'" cleanup >&2; exit 1; }
          . "$1"
        ' journey "$work/$r.sh"
      ) || { echo "journey $2: recipe $r FAILED after $(( $(date +%s) - start ))s" >&2; exit 1; }
      took=$(( $(date +%s) - start ))
      echo "journey $2: recipe $r passed in $((took / 60)):$(printf %02d $((took % 60)))"
    done
    now="$(cd "$ROOT" && . .githooks/lib.sh && eisen_source_hash)"
    if [ ! -s "$EISEN_JOURNEY" ]; then
      echo "journey $2: passed, not stamped: no recipe built the APK"
    elif grep -vqx "$now" "$EISEN_JOURNEY"; then
      echo "journey $2: passed, not stamped: the sources changed after the build"
    else
      (cd "$ROOT" && . .githooks/lib.sh && eisen_stamp emulator)
      echo "journey $2: passed, sources $now stamped as verified on the emulator"
    fi
    ;;
  journeys)
    # Several features at once, one emulator each taking the next feature that is free: the time of the
    # whole set is about that of its longest half. Every journey still runs each recipe from its first
    # command to its last and stamps as `journey` does. Without arguments: every feature file.
    shift
    all="$(/bin/ls "$ROOT/.claude/skills/verify-eisen/features" | sed -n 's/\.md$//p' | grep -v README)"
    # The long ones first, so the two emulators end close to each other.
    features="${*:-$(for f in layout food interval-timers; do echo "$all" | grep -qx "$f" && echo "$f"; done; echo "$all" | grep -vxE 'layout|food|interval-timers')}"
    for f in $features; do [ -f "$ROOT/.claude/skills/verify-eisen/features/$f.md" ] || die "no feature '$f', there are: $(echo $all)"; done
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    logs="$BASE/journeys-$(date +%Y%m%d-%H%M%S)"; claims="$logs/.claims"; mkdir -p "$claims"
    # One build for all: two emulators' first recipes would otherwise wait on each other's Gradle.
    (cd "$ROOT/apps/android" && ./gradlew assembleDebug -q) || die "the debug build failed"
    avds=""; started=""
    for avd in $AVDS; do "$EMULATOR" -list-avds | grep -qx "$avd" && avds="$avds $avd"; done
    [ "$(echo $features | wc -w)" -lt 2 ] && avds="$(echo $avds | cut -d" " -f1)"
    # An emulator a recipe's `launch` starts is stopped by that recipe's `cleanup`; started here, it stays
    # up for all of them and is stopped at the end. One that already ran is left running.
    for avd in $avds; do
      (
        export EISEN_AVD="$avd"; case "$avd" in eisen) port=5554;; *) port=5556;; esac; export ANDROID_SERIAL="emulator-$port"
        if ! "$ADB" devices | grep -q "^$ANDROID_SERIAL${TAB}device"; then
          nohup "$EMULATOR" -avd "$avd" -port "$port" -no-audio -no-snapshot-save -no-boot-anim > "$logs/emulator-$avd.log" 2>&1 &
          echo "$avd" >> "$claims/started"
          "$ADB" wait-for-device
        fi
        for _ in $(seq 120); do [ "$("$ADB" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ] && break; sleep 2; done
        # Booted is not yet ready: an emulator that had not run for days read no screen for its first
        # minutes, and every recipe's launch gave up after its 30 s. Wait until a read returns nodes.
        for _ in $(seq 90); do "$ADB" exec-out uiautomator dump /dev/tty 2>/dev/null | grep -q '<node' && break; sleep 2; done
      ) &
    done
    wait
    start=$(date +%s)
    for avd in $avds; do
      (
        for f in $features; do
          mkdir "$claims/$f" 2>/dev/null || continue
          began=$(date +%s)
          if EISEN_AVD="$avd" "$self" journey "$f" > "$logs/$f.log" 2>&1; then result=passed; else result=FAILED; EISEN_AVD="$avd" "$self" cleanup > /dev/null 2>&1; fi
          took=$(( $(date +%s) - began ))
          echo "$result" > "$claims/$f/result"
          echo "journeys: $f $result on $avd in $((took / 60)):$(printf %02d $((took % 60)))  ($logs/$f.log)"
        done
      ) &
    done
    wait
    for avd in $(cat "$claims/started" 2>/dev/null); do
      case "$avd" in eisen) port=5554;; *) port=5556;; esac
      ANDROID_SERIAL="emulator-$port" "$ADB" emu kill > /dev/null 2>&1
    done
    took=$(( $(date +%s) - start )); failed=""
    for f in $features; do [ "$(cat "$claims/$f/result" 2>/dev/null)" = passed ] || failed="$failed $f"; done
    [ -z "$failed" ] || die "journeys: failed after $((took / 60)):$(printf %02d $((took % 60))):$failed"
    # Every feature file passed on these sources: what the push gate asks for.
    if [ "$(echo $features | tr ' ' '\n' | sort | tr '\n' ' ')" = "$(echo $all | tr ' ' '\n' | sort | tr '\n' ' ')" ] \
      && [ "$(cd "$ROOT" && . .githooks/lib.sh && eisen_verified | grep -c emulator)" = 1 ]; then
      (cd "$ROOT" && . .githooks/lib.sh && eisen_stamp journeys)
    fi
    echo "journeys: all passed in $((took / 60)):$(printf %02d $((took % 60))) on$avds"
    ;;
  type) "$ADB" shell input text "$(echo "$2" | sed 's/ /%s/g')"; touched ;;
  back) "$ADB" shell input keyevent KEYCODE_BACK; touched; sleep 0.6 ;;
  scroll)
    case "${2:-down}" in down) "$ADB" shell input swipe 540 1700 540 800 300;; up) "$ADB" shell input swipe 540 800 540 1700 300;; *) die "scroll down|up";; esac
    touched
    # The list keeps rolling after the swipe, and a tap on a rolling list only stops it.
    sleep 1.5
    ;;
  shot)
    run="$(run_dir)"; [ -n "${2:-}" ] || die "shot <name>"
    "$ADB" exec-out screencap -p > "$run/$2.png"
    nodes > "$run/$2.txt"
    echo "$run/$2.png"
    ;;
  backup)
    # Where `launch` kept a file the emulator's app held before the run (each emulator has its own place).
    [ -n "${2:-}" ] || die "backup <file>, one of: $FILES"
    echo "$STATE/backup/$2"
    ;;
  state)
    # The saved state as the app wrote it: the second, read-only view of what a screen claims.
    run="$(run_dir)"; name="${2:-state}"
    file_of eisen.json > "$run/$name.json"
    echo "$run/$name.json"
    ;;
  log)
    run="$(run_dir)"
    "$ADB" logcat -d > "$run/logcat.txt"
    echo "$run/logcat.txt"
    ;;
  said)
    # The witness of what the muted coach said: every sound named must have its line in the log since launch.
    run="$(run_dir)"; shift; [ $# -gt 0 ] || die "said <sound>..."
    "$ADB" logcat -d > "$run/logcat.txt"
    missing=""
    for sound in "$@"; do grep -q "EisenTimer: said $sound\$" "$run/logcat.txt" || missing="$missing $sound"; done
    [ -z "$missing" ] || die "not said since launch:$missing (see $run/logcat.txt)"
    ;;
  release-smoke)
    # The signed release build (R8) on the emulator: install it, open every tab and the main ways in, fail on a crash,
    # an ANR or a class or method R8 took away; then the debug build and the app's files come back. Builds 22 and 23
    # broke only under R8, and every journey runs the debug build.
    shift; build=0; apk="$ROOT/apps/android/app/build/outputs/apk/release/app-release.apk"
    while [ $# -gt 0 ]; do
      case "$1" in
        --build) build=1;;
        --apk) [ -n "${2:-}" ] || die "--apk <file>"; apk="$2"; shift;;
        *) die "unknown option $1";;
      esac
      shift
    done
    mkdir -p "$STATE"
    [ -f "$STATE/run" ] && die "a run is open ($(cat "$STATE/run")): finish it with 'eisenctl cleanup' first"
    [ -n "$(device)" ] && booted || die "no booted emulator: start one with 'eisenctl launch', then 'eisenctl cleanup'"
    if [ "$build" = 1 ]; then
      keystore="${EISEN_KEYSTORE:-$HOME/.eisen/eisen-release.jks}"
      [ -f "$keystore" ] || die "no keystore at $keystore (EISEN_KEYSTORE)"
      password="${EISEN_KEYSTORE_PASSWORD:-$(cat "$HOME/.eisen/keystore-password.txt" 2>/dev/null)}"
      [ -n "$password" ] || die "no keystore password (EISEN_KEYSTORE_PASSWORD or ~/.eisen/keystore-password.txt)"
      (cd "$ROOT/apps/android" && EISEN_KEYSTORE="$keystore" EISEN_KEYSTORE_PASSWORD="$password" ./gradlew assembleRelease -q) || die "the release build failed"
    fi
    [ -f "$apk" ] || die "no release APK at $apk: build it (see SKILL.md) or pass --build"
    # Resource shrinking must keep every picture of a food: each is in the APK's resource table, under its own name.
    aapt2="$(ls -d "$SDK"/build-tools/*/aapt2 2>/dev/null | sort -V | tail -1)"
    [ -x "$aapt2" ] || die "no aapt2 under $SDK/build-tools"
    pictures="$("$aapt2" dump resources "$apk" | grep -oE 'drawable/food_[a-z_]+' | sort -u | wc -l | tr -d ' ')"
    wanted="$(ls "$ROOT/apps/android/app/src/main/res/drawable-nodpi" | grep -c '^food_')"
    [ "$pictures" = "$wanted" ] || die "the release APK holds $pictures of the $wanted pictures of the foods"
    [ -f "$APK" ] || (cd "$ROOT/apps/android" && ./gradlew assembleDebug -q) || die "the debug build failed, and it has to come back afterwards"
    run="$BASE/$(date +%Y%m%d-%H%M%S)-release$OWN"; mkdir -p "$run"; echo "$run" > "$STATE/run"
    # The debug app's files, kept here and put back into the debug build afterwards: the release build has another
    # signature, so the debug one is uninstalled with its data.
    mkdir -p "$STATE/backup"
    for name in $FILES; do file_of "$name" > "$STATE/backup/$name"; [ -s "$STATE/backup/$name" ] || rm -f "$STATE/backup/$name"; done
    for scale in window_animation_scale transition_animation_scale animator_duration_scale; do "$ADB" shell settings get global $scale | tr -d '\r' > "$STATE/$scale"; done
    "$ADB" shell settings get system font_scale | tr -d '\r' > "$STATE/font_scale"
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    # The photo of a label the release build reads through the photo picker; it goes again in restore.
    label="$ROOT/.claude/skills/verify-eisen/fixtures/labels/vanille-eis.jpg"
    [ -f "$label" ] || die "no label photo at $label"
    restore() {
      "$ADB" shell "rm -f /sdcard/Pictures/eisen-label-*.jpg" > /dev/null 2>&1
      "$ADB" shell content call --uri content://media --method scan_volume --arg external_primary > /dev/null 2>&1
      "$ADB" shell cmd connectivity airplane-mode disable > /dev/null 2>&1
      "$ADB" uninstall $PKG > /dev/null 2>&1
      "$ADB" install "$APK" > "$run/install-debug.log" 2>&1 || echo "eisenctl: the debug build did not go back on, see $run/install-debug.log" >&2
      "$ADB" shell "run-as $PKG mkdir -p files"
      for name in $FILES; do [ -f "$STATE/backup/$name" ] && "$ADB" shell "run-as $PKG sh -c 'cat > files/$name'" < "$STATE/backup/$name"; done
      "$ADB" shell pm grant $PKG android.permission.POST_NOTIFICATIONS 2>/dev/null
      for scale in window_animation_scale transition_animation_scale animator_duration_scale; do [ -s "$STATE/$scale" ] && "$ADB" shell settings put global $scale "$(cat "$STATE/$scale")"; done
      [ -s "$STATE/font_scale" ] && "$ADB" shell settings put system font_scale "$(cat "$STATE/font_scale")"
      /bin/rm -rf "$STATE"
      echo "evidence kept in $run"
    }
    fail() { echo "release-smoke: FAILED: $*" >&2; "$ADB" logcat -d -v threadtime > "$run/logcat.txt"; restore; exit 1; }
    "$ADB" uninstall $PKG > /dev/null 2>&1
    "$ADB" install "$apk" > "$run/install.log" 2>&1 || fail "the release APK did not install, see $run/install.log"
    "$ADB" shell pm grant $PKG android.permission.POST_NOTIFICATIONS 2>/dev/null
    for scale in window_animation_scale transition_animation_scale animator_duration_scale; do "$ADB" shell settings put global $scale 0; done
    # Muted, always.
    "$ADB" shell cmd audio set-volume 3 0 > /dev/null 2>&1
    "$ADB" shell input keyevent KEYCODE_WAKEUP
    "$ADB" shell wm dismiss-keyguard
    "$ADB" logcat -c
    "$ADB" shell am start -n $PKG/.MainActivity > /dev/null
    # Every step reads the screen itself: this run also sends input the kept read does not know of.
    go() { touched; "$self" "$@" || fail "$*"; }
    pids=""
    seen() { pids="$pids $("$ADB" shell pidof $PKG | tr -d '\r')"; }
    go wait "Start workout" 30 && seen && go shot 01-home
    # A workout started and discarded (nothing logged: no question).
    go tap "Start workout" && go wait "Finish" && go tap "More options" && go tap "Discard workout"
    "$self" has "Discard this workout\\?" 2> /dev/null && go tap "Discard workout"
    go wait "Start workout" && seen
    go tap "Workouts" && go wait "Workout A" && go shot 02-workouts
    # A timer's setup, then back to the list.
    go tap "Timer" && go tap "Timers" && go tap "Tabata" && go wait "Start" && go shot 03-timer-setup && go back
    # The Food tab, its add screen, the scanner (its own screen or the typed barcode, either way put away).
    go tap "Food" && go wait "0 kcal eaten" && go shot 04-food && go tap "\+ Add" && go wait "Search foods" && seen
    go tap "Scan" && sleep 5 && go shot 05-scan && seen && go back && sleep 1
    "$self" has "Look up" 2> /dev/null && go back
    go wait "Search foods" && go shot 06-after-scan
    # A typed barcode looked up without a network: the request, its failure and the sheet, with no answer needed. A
    # release build reads no local answers (only debug builds do), so this is the lookup that needs no network.
    "$ADB" shell cmd connectivity airplane-mode enable > /dev/null 2>&1
    go tap "Type a barcode" && go wait "Look up" && go type 4006381333931 && go tap "Look up"
    go wait "No network. Check the connection and try again." 30 && go shot 07-no-network
    "$ADB" shell cmd connectivity airplane-mode disable > /dev/null 2>&1
    go tap "Close" && go wait "Search foods"
    # Where a barcode nobody knows lands: the own food form, saved and on the plate, then logged.
    # Its picture follows the name, and the grid of the 42 pictures opens and picks one (the pictures are resources R8 and
    # resource shrinking must keep).
    for _ in 1 2 3 4; do "$self" visible "New food" 2> /dev/null && break; "$self" scroll down; done
    go tap "New food" && go wait "Save food" && go tap "Name" && go type "Smoke Milch" && go back && go wait "Picture: Milk"
    go tap "Picture: Milk" && go wait "Ice cream" && go shot 07b-pictures && go tap "Oats and muesli" && go wait "Picture: Oats and muesli"
    go tap "Save food" && go wait "Add .* kcal to the plate" && go has "Picture: Oats and muesli" && go tap "Add .* kcal to the plate"
    go wait "Log .* kcal" && go tap "Log .* kcal" && go wait "Logged 1 food" && go shot 08-logged && seen
    # A photo of a label through the system's photo picker, read on the phone by ML Kit (its native library, its models and
    # its components under R8): the form must show the label's values, each read. Gut & Günstig's Vanille Eis: 200 kcal,
    # 1.6 g protein, 25.5 g carbs, 10.1 g fat, a portion of 50 g.
    "$ADB" shell "rm -f /sdcard/Pictures/eisen-label-*.jpg" && "$ADB" push "$label" /sdcard/Pictures/eisen-label-vanille-eis.jpg > /dev/null \
      && "$ADB" shell content call --uri content://media --method scan_volume --arg external_primary > /dev/null || fail "the label photo did not reach the pictures"
    go tap "\\+ Add" && go wait "Search foods"
    for _ in 1 2 3 4 5 6; do "$self" visible "Photo of the label" 2> /dev/null && break; "$self" scroll down; done
    go tap "Photo of the label" && go wait "Choose a photo" && go tap "Choose a photo" && go wait "Photo taken on .*" 20 && go tap "Photo taken on .*" 1
    go wait "Calories read from the photo" 30 && go back
    go has "Calories read from the photo" "Protein read from the photo" "calories per 100 g 200 kcal" "protein per 100 g 1.6 g" && go shot 08b-label-read && seen
    for _ in 1 2 3; do "$self" visible "Save food" 2> /dev/null && break; "$self" scroll down; done
    go has "Carbs read from the photo" "Fat read from the photo" "carbs per 100 g 25.5 g" "fat per 100 g 10.1 g" "serving 50 g" && go shot 08c-label-read-below
    go tap "Close" && go wait "Search foods" && go tap "Back" && go wait "Food data"
    # Settings behind the gear on Home, History and its Progress.
    go tap "Home" && go wait "Start workout" && go tap "Settings" && go wait "Weights" && go shot 09-settings && go back && go wait "Start workout"
    go tap "History" && go tap "Progress" && go wait "Finish your first workout and your progress shows up here." && go shot 10-progress && seen
    # Its Weight section: a weight logged from the sheet there starts the trend (the weight log and its JSON under R8).
    for _ in 1 2 3; do "$self" has "Log weight" 2> /dev/null && break; "$self" scroll down; done
    go tap "Log weight" && go wait "Save 80 kg" && go tap "Save 80 kg" && go wait "Weight over time, 1 weight, trend 80 kg.*" && go shot 11-weight && seen
    "$ADB" logcat -d -v threadtime > "$run/logcat.txt"
    # What breaks under R8: a crash, an ANR, a class or a method it took away, ML Kit's components not found, a native
    # method it renamed.
    pids="$(echo $pids | tr ' ' '\n' | grep -E '^[0-9]+$' | sort -u | tr '\n' ' ')"
    ours="$(awk -v pids=" $pids " 'index(pids, " " $3 " ")' "$run/logcat.txt")"
    bad="$( { echo "$ours" | grep -E "FATAL EXCEPTION|ClassNotFoundException|NoSuchMethodException|NoSuchMethodError|UnsatisfiedLinkError|ComponentDiscovery|label photo could not|text recognition could not"; grep -E "FATAL EXCEPTION|ANR in $PKG|Process: $PKG" "$run/logcat.txt"; } | sort -u)"
    [ -z "$bad" ] || fail "the log of the release build says:
$(echo "$bad" | cut -c1-220 | head -20)"
    echo "release-smoke: passed, pids $pids, log $run/logcat.txt"
    restore
    ;;
  adb) shift; touched; "$ADB" "$@" ;;
  dish)
    # What a debug build answers for a photo of a dish instead of asking a model (the emulator has none): written to the
    # app's files/dish-ai.txt, "\n" between its lines. `cleanup` clears it with the app's data; a release build never reads it.
    [ -n "${2:-}" ] || die 'dish "<answer>", such as "rice, cooked; 180\negg, fried; 50"'
    [ -d "$STATE" ] || die "no run is open (eisenctl launch)"
    touched
    printf '%b\n' "$2" > "$STATE/dish-ai.txt"
    "$ADB" shell "run-as $PKG sh -c 'cat > files/dish-ai.txt'" < "$STATE/dish-ai.txt"
    ;;
  cleanup)
    [ -d "$STATE" ] || { echo "nothing to clean up"; exit 0; }
    if [ -n "$(device)" ]; then
      # No stamp here: only `journey`, a recipe run from its first command to its last, stamps the sources.
      "$ADB" shell am force-stop $PKG
      if [ -d "$STATE/backup" ]; then
        "$ADB" shell pm clear $PKG > /dev/null
        "$ADB" shell "run-as $PKG mkdir -p files"
        for name in $FILES; do
          [ -f "$STATE/backup/$name" ] && "$ADB" shell "run-as $PKG sh -c 'cat > files/$name'" < "$STATE/backup/$name"
        done
        "$ADB" shell pm grant $PKG android.permission.POST_NOTIFICATIONS 2>/dev/null
      fi
      for scale in window_animation_scale transition_animation_scale animator_duration_scale; do "$ADB" shell settings put global $scale 1; done
      [ -s "$STATE/font_scale" ] && "$ADB" shell settings put system font_scale "$(cat "$STATE/font_scale")"
      # Only an emulator this run started is stopped.
      if [ -f "$STATE/emulator.pid" ] && kill -0 "$(cat "$STATE/emulator.pid")" 2>/dev/null; then "$ADB" emu kill > /dev/null 2>&1; fi
    fi
    [ -f "$STATE/run" ] && echo "evidence kept in $(cat "$STATE/run")"
    /bin/rm -rf "$STATE"
    ;;
  *)
    cat <<USAGE
eisenctl launch [--fresh] [--no-build] [--state <name>] [--animations]
                                         build, install, start; --fresh starts from empty app data,
                                         --state from fixtures/<name>.json (implies --fresh): $(fixtures)
                                         --animations leaves the animation scales at 1, as on a phone
eisenctl journeys [feature...]           several features at once, spread over the emulators ($AVDS); all without arguments
eisenctl backup <file>                   the path of a file the app held before this run (eisen.json, ...)
eisenctl doctor                          read-only: is this instance worth driving?
eisenctl texts                           what is on screen: text=... and content-desc=... with bounds
eisenctl has <regex>...                  exit 0 when each regex matches a whole text or description
eisenctl gone <regex>...                 exit 0 when none of them is on screen (a fresh read; not `! eisenctl has`)
eisenctl wait <regex> [seconds]          until it appears (default 15)
eisenctl tap <regex> [n]                 tap the n-th match (default the first)
eisenctl doubletap <regex> [n] [gap-ms]  two finger taps from one dump, gap-ms apart (default 150)
eisenctl hold <regex> [n]                press it for a second ("Hold to finish")
eisenctl type <text> | back | scroll down|up
eisenctl font <scale>                    the system font scale (1.0, 1.3, 2.0); cleanup puts back the old one
eisenctl visible <regex>...              each on screen, not cut off, tapped on at least 48 dp
eisenctl small                           fails listing every clickable node on screen under 48 dp
eisenctl shot <name>                     screenshot + the screen's texts into the run's evidence directory
eisenctl state [name]                    the saved eisen.json into the evidence directory
eisenctl log                             logcat since launch into the evidence directory
eisenctl said <sound>...                 fails unless the log has "EisenTimer: said <sound>" for each
eisenctl buzzed                          fails unless a vibration of the app played since launch, none dropped
eisenctl journey <feature> [recipe]      run a feature file's recipes, stop at the first failing command;
                                         only a journey that passed stamps the sources "Verified: emulator"
eisenctl release-smoke [--build] [--apk <file>]
                                         the signed release APK (R8) installed instead of debug: every tab and the main
                                         ways in, fails on a crash, an ANR or R8's missing classes; then debug is back
eisenctl adb <args>                      plain adb
eisenctl cleanup                         restore the emulator's app data and settings, keep the evidence
USAGE
    ;;
esac
